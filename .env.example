# Configure an explicitly authorized MySQL database for API/CLI use.
# scripts/dev.sh isolates its own database and generates separate credentials.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SOCKET=
# Alternatively configure DB_ADDR (TCP with TLS, mutually exclusive with DB_SOCKET).
DB_ADDR=
EMA_ASSETS=
EMA_API_ADDR=127.0.0.1:8080
